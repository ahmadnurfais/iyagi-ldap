LLDAP_HTTP_BIND_ADDRESS=127.0.0.1
LLDAP_LDAPS_BIND_ADDRESS=127.0.0.1
LLDAP_LDAPS_PORT=16360
LLDAP_HTTP_PORT=17170
LLDAP_NETWORK_NAME=iyagi-directory
LLDAP_CONTAINER_NAME=iyagi-lldap
LLDAP_CERT_DNS_NAMES=lldap.iyagi.internal,localhost
LLDAP_CERT_IP_ADDRESSES=127.0.0.1

# Admin Web UI is served via Caddy in front of the audit interceptor.
# The old direct-to-lldap HTTP port (17170) is no longer published on the host.
LLDAP_ADMIN_UI_BIND_ADDRESS=127.0.0.1
LLDAP_ADMIN_UI_PORT=18443

# Cross-project ingress network to iyagi-grafana. Must be created by iyagi-grafana
# (via its init-grafana.sh) before this stack is started.
LLDAP_GRAFANA_INGRESS_NETWORK_NAME=iyagi-grafana-ingress
