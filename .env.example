LLDAP_LDAPS_BIND_ADDRESS=127.0.0.1
LLDAP_LDAPS_PORT=16360
LLDAP_NETWORK_NAME=iyagi-directory
LLDAP_CONTAINER_NAME=iyagi-lldap
LLDAP_CERT_DNS_NAMES=lldap.iyagi.internal,localhost
LLDAP_CERT_IP_ADDRESSES=127.0.0.1

# Host Nginx terminates production HTTPS and proxies to this loopback audit gateway.
# LLDAP's direct HTTP port (17170) is not published on the host.
LLDAP_ADMIN_UI_BIND_ADDRESS=127.0.0.1
LLDAP_ADMIN_UI_PORT=18443

# Optional observability profile. Configure these only before starting Alloy with:
# docker compose --profile observability up -d alloy
# IYAGI_ENVIRONMENT=production
# IYAGI_HOST=lldap-vps
# LOKI_WRITE_URL=https://logs.example.com/loki/api/v1/push
# LOKI_INGEST_USERNAME=lldap
# LOKI_CA_HOST_FILE=/etc/ssl/certs/ca-certificates.crt
# LOKI_CA_FILE=/etc/ssl/certs/ca-certificates.crt
