{
	admin off
	log {
		output file /var/log/caddy/caddy.log {
			roll_size 100mb
			roll_keep 30
			roll_keep_for 8760h
		}
		format json
		level INFO
	}
}

# TLS-terminated admin UI facing the operator. Caddy generates a self-signed
# internal certificate on first start. In production, replace with a certificate
# signed by the internal CA already used for lldap-server.crt.
https://localhost:8443, https://127.0.0.1:8443, https://lldap.iyagi.internal:8443 {
	tls internal

	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 30
			roll_keep_for 8760h
		}
		format json
	}

	encode gzip

	reverse_proxy audit-interceptor:8080 {
		header_up X-Forwarded-For {remote_ip}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
	}
}
